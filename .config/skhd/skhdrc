shift + alt - 3 : yabai -m window --space 3; $HOME/.config/custom-scripts/switch-spaces/switchToSpace3.sh
shift + alt - 4 : yabai -m window --space 4; $HOME/.config/custom-scripts/switch-spaces/switchToSpace4.sh
shift + alt - 5 : yabai -m window --space 5; $HOME/.config/custom-scripts/switch-spaces/switchToSpace5.sh
shift + alt - 6 : yabai -m window --space 6; $HOME/.config/custom-scripts/switch-spaces/switchToSpace6.sh
# shift + alt - 7 : yabai -m window --space 7; $HOME/.config/custom-scripts/switch-spaces/switchToSpace7.sh
shift + alt - 7 : yabai -m window --space 7; $HOME/.config/custom-scripts/switch-spaces/switchToSpaceTilde.sh
