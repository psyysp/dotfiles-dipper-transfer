# shift + alt - 6 : yabai -m window --space 6; yabai -m space --focus 6

shift + alt - b : yabai -m space --focus 2

# increase window size
# shift + alt + fn - h : yabai -m window --resize left:-20:0
# shift + alt + fn - j : yabai -m window --resize bottom:0:20
# shift + alt + fn - k : yabai -m window --resize top:0:-20
# shift + alt + fn - l : yabai -m window --resize right:20:0

# decrease window size
# shift + alt + ctrl - h : yabai -m window --resize right:-20:0
# shift + alt + ctrl - j : yabai -m window --resize top:0:20
# shift + alt + ctrl - k : yabai -m window --resize bottom:0:-20
# shift + alt + ctrl - l : yabai -m window --resize left:20:0

# increase/decrease window size with same keybinds
shift + alt + ctrl - h : \
    yabai -m window --resize left:-20:0 ; \
    yabai -m window --resize right:-20:0

shift + alt + ctrl - j : \
    yabai -m window --resize bottom:0:20 ; \
    yabai -m window --resize top:0:20

shift + alt + ctrl - k : \
    yabai -m window --resize top:0:-20 ; \
    yabai -m window --resize bottom:0:-20

shift + alt + ctrl - l : \
    yabai -m window --resize right:20:0 ; \
    yabai -m window --resize left:20:0

## rotate tree 90
# hyper - r : yabai -m space --rotate 90
alt - r : yabai -m space --rotate 90

## mirror tree y-axis (flip the tree vertically)
# hyper - i : yabai -m space --mirror y-axis
alt - y : yabai -m space --mirror y-axis
## mirror tree x-axis (flip the tree horizontally)
alt - x : yabai -m space --mirror x-axis

## toggle window fullscreen zoom
# hyper - f : yabai -m window --toggle zoom-fullscreen
alt - f : yabai -m window --toggle zoom-fullscreen

## cycle through windows
## cycle backwards
# hyper - i : yabai -m query --spaces | jq -re ".[] | select(.visible == 1).index" | xargs -I{} yabai -m query --windows --space {} | jq -sre "add | sort_by(.display, .frame.x, .frame.y, .id) | nth(index(map(select(.focused == 1))) - 1).id" | xargs -I{} yabai -m window --focus {}
# hyper - i : yabai -m query --spaces | jq -re ".[] | select(.visible == 1).index" | xargs -I{} yabai -m query --windows --space {} | jq -sre "add | sort_by(.display, .frame.x, .frame.y, .id) | nth(index(map(select(.focused == 1))) - 1).id" | xargs -I{} yabai -m window --focus {}

